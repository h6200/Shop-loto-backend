PORT=8080
# Lis nimewo admin, separe pa vigil. Chak nimewo sa yo ap gen aksè admin.
ADMIN_PHONES=50900000000
# Kle sekrè pou token. FÒK ou chanje li an pwodiksyon!
JWT_SECRET=chanje-sa-a-yon-valè-sekrè-long
# Chemen fichye done JSON (pa bezwen chanje an jeneral)
DATABASE_PATH=./data/data.json

# PIN admin (APK pa janm gen li — sèlman backend la verifye)
ADMIN_PIN=4798

# Kobara peman
KOBARA_SECRET_KEY=
KOBARA_WEBHOOK_SECRET=

# APK otomatik update (mete vèsyon ak URL download APK ki pi resan)
LATEST_APK_VERSION=3.7.0
LATEST_APK_CODE=7
LATEST_APK_URL=
FORCE_UPDATE=false
